# Furfoo storefront API — copy to .env (never commit the filled-in file).

APP_ENV=development
PORT=4321

# Where the browser reaches this service and the shop. Both are required once a
# payment gateway is involved: the gateway calls PUBLIC_API_URL and sends the
# customer back to PUBLIC_SITE_URL.
PUBLIC_API_URL=http://localhost:4321
PUBLIC_SITE_URL=http://localhost:5173

# Browser origins allowed to call this API. Exact matches, comma separated.
ALLOWED_ORIGINS=http://localhost:5173

# --- The POS ----------------------------------------------------------------
# A dedicated employee account, not a person's login. Its role needs
# view_stock (or access_pos) to read the catalogue and import_online_orders to
# record a paid website order.
POS_BASE_URL=https://pos.furfoopet.com
POS_USERNAME=website
POS_PASSWORD=
# How long a catalogue read is reused before the POS is asked again. Checkout
# always re-reads stock, whatever this says.
POS_CATALOG_TTL_MS=60000
POS_REQUEST_TIMEOUT_MS=10000

# --- What the shop publishes ------------------------------------------------
# Product statuses that may appear on the website.
CATALOG_PUBLISHED_STATUSES=active
# Optional allowlist by SKU prefix, e.g. FF-TRT-,FF-HB- . Empty publishes every
# active product the POS holds.
CATALOG_SKU_PREFIXES=
# Products never published, whatever their status.
CATALOG_SKU_BLOCKLIST=
CATALOG_HIDE_ZERO_PRICE=true

# --- Money ------------------------------------------------------------------
CURRENCY=MYR
SHIPPING_FLAT_CENTS=800
SHIPPING_FREE_OVER_CENTS=10000
ORDER_MAX_ITEM_QTY=20
ORDER_MAX_LINE_ITEMS=30
ORDER_UNPAID_EXPIRY_MINUTES=60

# Website orders. Keep this file outside the deployed application directory, so
# a deployment cannot replace it. It is NOT the POS database and must never
# point at one.
ORDERS_DATABASE_PATH=../furfoo-data/storefront/storefront.sqlite

# --- Payment ----------------------------------------------------------------
# manual = bank transfer / WhatsApp, confirmed by the shop.
# toyyibpay = FPX and card, confirmed by the gateway.
PAYMENT_PROVIDER=manual
MANUAL_PAYMENT_INSTRUCTIONS=Bank transfer to Maybank 1234 5678 9012 (Furfoo Pet).
MANUAL_PAYMENT_WHATSAPP=60199123946

TOYYIBPAY_BASE_URL=https://toyyibpay.com
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=

# --- Shop admin -------------------------------------------------------------
# Bearer token for the owner-only endpoints (order list, mark paid, retry).
# At least 24 characters; required in production and staging.
STOREFRONT_ADMIN_TOKEN=

CHECKOUT_RATE_LIMIT_PER_MINUTE=10
CATALOG_RATE_LIMIT_PER_MINUTE=120
# Reverse proxies in front of this service. Hostinger terminates one.
TRUSTED_PROXY_HOPS=1
